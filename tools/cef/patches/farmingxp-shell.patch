+// ── Game server lifecycle ───────────────────────────────────────────────────
+// The game is a web page served by a local HTTP server. This shell owns that
+// server: it spawns it, waits until the port answers, and guarantees it dies
+// with the shell - even on a crash - via a Job Object with KILL_ON_JOB_CLOSE.
+//
+//   --game-server="<command line>"   e.g. "C:\...un.exe run server.ts"
+//   --game-server-cwd=<dir>          working directory for the server
+//   --game-server-port=<n>           port to wait for (default 43110)
+//
+// Without --game-server nothing happens (the URL is assumed to be up already).
+
+HANDLE g_game_server_job = nullptr;
+
+// ── Steam in the shell process ──────────────────────────────────────────────
+// GameOverlayActivated_t is delivered only to the process that hosts the
+// overlay - this one - so this is where it must be caught. The page gets a
+// plain DOM event on window; what to do with it (pause) is the game's call.
+
+void SendToPage(const std::string& js) {
+  if (!CefCurrentlyOn(TID_UI)) {
+    CefPostTask(TID_UI, base::BindOnce(SendToPage, js));
+    return;
+  }
+  auto root = MainContext::Get()->GetRootWindowManager()->GetActiveRootWindow();
+  CefRefPtr<CefBrowser> browser = root ? root->GetBrowser() : nullptr;
+  if (browser && browser->GetMainFrame()) {
+    browser->GetMainFrame()->ExecuteJavaScript(js, "", 0);
+  }
+}
+
+class SteamBridge {
+ public:
+  SteamBridge() : overlay_cb_(this, &SteamBridge::OnOverlay) {}
+
+  void OnOverlay(GameOverlayActivated_t* ev) {
+    const bool active = ev->m_bActive != 0;
+    SendToPage(std::string("window.dispatchEvent(new CustomEvent('steam:overlay',{detail:{active:") +
+               (active ? "true" : "false") + "}}))");
+  }
+
+ private:
+  CCallback<SteamBridge, GameOverlayActivated_t, false> overlay_cb_;
+};
+
+SteamBridge* g_steam_bridge = nullptr;
+
+// Pumped from the main-thread message loop (the thread that called Init).
+void CALLBACK SteamPumpTimer(HWND, UINT, UINT_PTR, DWORD) {
+  SteamAPI_RunCallbacks();
+}
+
+UINT_PTR g_steam_pump_timer = 0;
+
+bool StartSteam() {
+  if (!SteamAPI_Init()) {
+    return false;  // Steam closed / no appid: the game runs without it.
+  }
+  g_steam_bridge = new SteamBridge();
+  g_steam_pump_timer = SetTimer(nullptr, 0, 100, SteamPumpTimer);
+  return true;
+}
+
+// Order matters: the timer must be dead BEFORE SteamAPI_Shutdown, because
+// CefShutdown pumps the message loop and a live timer would call
+// RunCallbacks on a torn-down API - which hangs the process in the kernel
+// at exit (seen as unkillable cefclient.exe zombies holding the profile lock).
+void StopSteam() {
+  if (g_steam_pump_timer) {
+    KillTimer(nullptr, g_steam_pump_timer);
+    g_steam_pump_timer = 0;
+  }
+  if (g_steam_bridge) {
+    delete g_steam_bridge;
+    g_steam_bridge = nullptr;
+    SteamAPI_Shutdown();
+  }
+}
+
+bool PortAnswers(int port) {
+  SOCKET s = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
+  if (s == INVALID_SOCKET) {
+    return false;
+  }
+  sockaddr_in addr = {};
+  addr.sin_family = AF_INET;
+  addr.sin_port = htons(static_cast<u_short>(port));
+  addr.sin_addr.s_addr = htonl(INADDR_LOOPBACK);
+  const bool ok = connect(s, reinterpret_cast<sockaddr*>(&addr), sizeof(addr)) == 0;
+  closesocket(s);
+  return ok;
+}
+
+bool StartGameServer(CefRefPtr<CefCommandLine> command_line) {
+  if (!command_line->HasSwitch("game-server")) {
+    return true;
+  }
+  std::wstring cmd = command_line->GetSwitchValue("game-server").ToWString();
+  std::wstring cwd = command_line->GetSwitchValue("game-server-cwd").ToWString();
+  int port = 43110;
+  if (command_line->HasSwitch("game-server-port")) {
+    port = _wtoi(command_line->GetSwitchValue("game-server-port").ToWString().c_str());
+  }
+
+  WSADATA wsa;
+  WSAStartup(MAKEWORD(2, 2), &wsa);
+
+  // Already up (dev: server started by hand)? Reuse it, don't spawn a second.
+  if (PortAnswers(port)) {
+    return true;
+  }
+
+  // Job object: when the last handle closes (this process exits, however it
+  // exits) every process in the job is killed. No orphan servers.
+  g_game_server_job = CreateJobObjectW(nullptr, nullptr);
+  if (g_game_server_job) {
+    JOBOBJECT_EXTENDED_LIMIT_INFORMATION info = {};
+    info.BasicLimitInformation.LimitFlags = JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE;
+    SetInformationJobObject(g_game_server_job, JobObjectExtendedLimitInformation,
+                            &info, sizeof(info));
+  }
+
+  // The server reads the port from the environment (server.ts: PORT).
+  SetEnvironmentVariableW(L"PORT", std::to_wstring(port).c_str());
+
+  STARTUPINFOW si = {sizeof(si)};
+  PROCESS_INFORMATION pi = {};
+  std::wstring mutable_cmd = cmd;  // CreateProcessW may modify the buffer.
+  if (!CreateProcessW(nullptr, &mutable_cmd[0], nullptr, nullptr, FALSE,
+                      CREATE_NO_WINDOW | CREATE_SUSPENDED, nullptr,
+                      cwd.empty() ? nullptr : cwd.c_str(), &si, &pi)) {
+    return false;
+  }
+  if (g_game_server_job) {
+    AssignProcessToJobObject(g_game_server_job, pi.hProcess);
+  }
+  ResumeThread(pi.hThread);
+  CloseHandle(pi.hThread);
+  CloseHandle(pi.hProcess);
+
+  // Wait up to 20s for the port. Bun + esbuild first-load can take a few s.
+  for (int i = 0; i < 200; i++) {
+    if (PortAnswers(port)) {
+      return true;
+    }
+    Sleep(100);
+  }
+  return false;
+}
